# Local: the Docker Compose database. On Render: the database's INTERNAL URL (Render Postgres > Connections > Internal Database URL).
# To run the migration and the seed from your computer against Render, use the EXTERNAL URL instead.
# "postgres://" and "postgresql://" are both fine, the app changes them to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://smileslot:smileslot@localhost:5433/smileslot
# Comma-separated origins, each with https:// or http:// and no trailing slash.
# On Render: the Static Site's address, e.g. https://smileslot-web.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Either the path to the service-account key file, or the JSON content itself (starts with "{").
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional, used only by "python -m app.seed": Google Calendar id for the first doctor.
DEMO_CALENDAR_ID=
TIMEZONE=Europe/Skopje
